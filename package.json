{
    "name": "seyfert-template",
    "version": "1.0.0",
    "description": "A simple template for Seyfert projects.",
    "main": "./dist/index.js",
    "author": "Ganyu Studios",
    "type": "module",
    "license": "MIT",
    "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
    "scripts": {
        "build": "tsc",
        "test": "tsx ./src/index.ts --debug --dev",
        "dev": "tsx ./src/index.ts --dev",
        "start": "node ./dist/index.js",
        "lint": "biome lint --write .",
        "format": "biome check --write .",
        "typecheck": "tsc --noEmit",
        "prepare": "husky"
    },
    "contributors": [
        {
            "url": "https://github.com/EvilG-MC",
            "name": "JustEvil"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ganyu-Studios/seyfert-template.git"
    },
    "lint-staged": {
        "{*.ts,*.json}": [
            "pnpm format"
        ]
    },
    "keywords": [
        "seyfert",
        "template",
        "typescript",
        "node",
        "discord",
        "bot",
        "framework"
    ],
    "dependencies": {
        "dotenv": "^18.0.7",
        "seyfert": "5.1.1-dev-37556387916.0",
        "yunaforseyfert": "^1.2.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/node": "^26.6.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
